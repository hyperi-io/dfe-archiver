# Project:      dfe-archiver
# File:         .env.example
# Purpose:      Example environment variables — copy to .env and fill in real values
# Language:     Shell
#
# License:      BUSL-1.1
# Copyright:    (c) 2026 HyperI Pty Ltd
#
# Usage: cp .env.example .env && $EDITOR .env
# Always quote values — no exceptions.

# =============================================================================
# Test Mode Selection
# =============================================================================
# "docker"  — use dfe-docker infra profile (Redpanda on localhost:19092, no auth)
# "remote"  — use DevEx infrastructure from the settings below
#
# Docker:  TEST_MODE="docker" cargo test --test e2e_test -- --ignored
# Remote:  TEST_MODE="remote" cargo test --test e2e_test -- --ignored
TEST_MODE="remote"

# =============================================================================
# Kafka Configuration (Remote)
# =============================================================================
KAFKA_BROKERS="localhost:9092"
KAFKA_SECURITY_PROTOCOL="PLAINTEXT"
KAFKA_GROUP_ID="dfe-archiver"
KAFKA_TOPICS=""

# SASL is all-or-nothing: a mechanism with no username and password is rejected
# at startup. Uncomment all four together, with real values.
# KAFKA_SECURITY_PROTOCOL="SASL_PLAINTEXT"
# KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
# KAFKA_SASL_USER=""
# KAFKA_SASL_PASSWORD=""

# =============================================================================
# Kafka Configuration (Docker Local — Redpanda)
# =============================================================================
# Start: docker compose -f docker-compose.dev.yaml up -d
# Then uncomment:
# KAFKA_BROKERS="localhost:19092"
# KAFKA_SECURITY_PROTOCOL="PLAINTEXT"

# =============================================================================
# Archiver Configuration
# =============================================================================
ARCHIVER_DESTINATION="file:///tmp/dfe-archiver-test"
ARCHIVER_COMPRESSION_CODEC="zstd"
ARCHIVER_FLUSH_BYTES="1048576"
ARCHIVER_FLUSH_INTERVAL_SECS="5"

# =============================================================================
# Metrics
# =============================================================================
# The listener binds from --metrics-addr, then METRICS_ADDR, then
# ARCHIVER_METRICS__ADDRESS in the config cascade. There is no METRICS_ADDRESS.
METRICS_ADDR="0.0.0.0:9090"

# =============================================================================
# MemoryGuard (cgroup-aware, K8s auto-detect)
# =============================================================================
# ARCHIVER_ is the app's env prefix, and scalo's MemoryGuard reads these three
# names itself -- a DFE_ARCHIVER_ prefix reaches nothing.
# 0 = auto-detect from cgroup (recommended for K8s)
ARCHIVER_MEMORY_LIMIT_BYTES="0"
ARCHIVER_MEMORY_PRESSURE_THRESHOLD="0.80"
ARCHIVER_MEMORY_CGROUP_HEADROOM="0.85"

# =============================================================================
# Startup version check
# =============================================================================
# false = no check, nothing sent (air-gapped installs).
# ARCHIVER_VERSION_CHECK__ENABLED="false"

# =============================================================================
# S3 Integration Tests (AWS)
# =============================================================================
# Run: cargo test --test s3_test -- --ignored
# Refresh creds: eval $(aws configure export-credentials --profile <profile> --format env)
S3_BUCKET=""
S3_REGION="ap-southeast-2"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""
# Set S3_ALLOW_HTTP=true ONLY for local/dev endpoints (MinIO, LocalStack).
# Production MUST use HTTPS (the default).
# S3_ALLOW_HTTP="false"

# =============================================================================
# GCS Integration Tests (Google Cloud)
# =============================================================================
# Run: cargo test --test gcs_test -- --ignored
GCS_BUCKET=""
# GCS_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# =============================================================================
# Azure Integration Tests (Azure Blob Storage)
# =============================================================================
# Run: cargo test --test azure_test -- --ignored
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
AZURE_CONTAINER=""

# =============================================================================
# MinIO Integration Tests (Docker Local)
# =============================================================================
# Start: docker compose -f docker-compose.dev.yaml up -d minio
# Run:   cargo test --test minio_test -- --ignored
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="archive-test"
